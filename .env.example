# Adwam: variables for local development
#
# The agent copies this to apps/mobile/.env.local in milestone 0 (task M0.5)
# and fills it in. Git ignores every env file except this example.
#
# NO SECRETS GO IN THIS FILE OR ITS COPIES. Everything below is either a
# local value that's the same on every machine, or left empty so a service
# stays off. Real secrets live in each service's own store, because builds
# and CI run in the cloud and can't read files on this PC:
#
#   GitHub    repository > Settings > Environments > staging / production
#   EAS       expo.dev > the Adwam project > Environment variables
#   Supabase  dashboard > Edge Functions > Secrets
#
# docs/development-setup.md lists every secret, where it comes from and when
# it's needed.

# ------------------------------------------------------------------
# apps/mobile/.env.local
# ------------------------------------------------------------------

# Which build this is. Each value picks the app ID and name:
#   development  com.msalman5230.adwam.dev      "Adwam Dev"
#   preview      com.msalman5230.adwam.preview  "Adwam Preview"
#   production   com.msalman5230.adwam          "Adwam"
# EAS sets it for cloud builds. Locally it's always development.
APP_VARIANT=development

# Local Supabase, as the Android emulator sees this PC.
# For a phone on USB, run `adb reverse tcp:54321 tcp:54321`
# and use http://localhost:54321 instead.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321

# Local Supabase's publishable key (older versions call it the anon key).
# After `pnpm db:start`, copy it from `supabase status`. It's the same on
# every machine and isn't secret. The agent fills it in.
EXPO_PUBLIC_SUPABASE_KEY=

# Crash reports. Empty locally, so Sentry stays off.
EXPO_PUBLIC_SENTRY_DSN=

# Usage statistics. Empty locally, so PostHog stays off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ------------------------------------------------------------------
# supabase/functions/.env
# Only from milestone 5, and only to send real pushes from this PC.
# ------------------------------------------------------------------

# Expo access token for sending pushes, from the MSalman5230 Expo account.
# The only secret that may ever sit on this PC. Leave it commented out
# until a test needs it.
# EXPO_ACCESS_TOKEN=
