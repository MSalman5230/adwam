{
  "name": "adwam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:check",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "content:check": "node scripts/pending.mjs content:check",
    "content:build": "node scripts/pending.mjs content:build",
    "android": "pnpm --filter @adwam/mobile --fail-if-no-match android",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "server:prepare": "node scripts/pending.mjs server:prepare",
    "server:test": "node scripts/pending.mjs server:test",
    "server:tick": "node scripts/pending.mjs server:tick",
    "server:simulate-rain": "node scripts/pending.mjs server:simulate-rain"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-i18next": "6.1.5",
    "globals": "^17.0.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
